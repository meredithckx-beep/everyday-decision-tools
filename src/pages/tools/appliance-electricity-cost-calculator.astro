---
import ToolShell from '../../components/ToolShell.astro';
---
<ToolShell title="Appliance Electricity Cost Calculator" category="Home costs" toolId="appliance-electricity" description="Estimate household appliance electricity use and costs per day, month, and year." intro="Estimate the running cost of one appliance, or compare two appliances to understand potential savings." steps={["Choose Power & Usage or Daily Energy input for each appliance.","Enter your local electricity price per kWh.","Optionally compare a second appliance or test the savings from using an appliance one hour less per day."]} note="Rated power is not always the same as average real-world power. Refrigerators and air conditioners cycle on and off. If you have measured kWh data from a smart plug or meter, use the Daily Energy option for a more realistic estimate.">
  <h2>Appliance electricity cost</h2><div class="field"><label for="appliance-mode">Input method</label><select id="appliance-mode" data-field="applianceMode"><option value="power">Power & Usage</option><option value="energy">Daily Energy Consumption</option></select></div>
  <div class="field-grid" id="appliance-a"><div class="field"><label for="power-a">Power (W)</label><input id="power-a" data-field="powerA" type="number" min="0" value="0" /></div><div class="field"><label for="hours-a">Hours used per day</label><input id="hours-a" data-field="hoursA" type="number" min="0" max="24" step="0.1" value="0" /></div><div class="field field-full energy-field" hidden><label for="energy-a">Energy used per day (kWh)</label><input id="energy-a" data-field="energyA" type="number" min="0" step="any" value="0" /></div><div class="field field-full"><label for="rate-a">Electricity price (USD/kWh)</label><input id="rate-a" data-field="rateA" type="number" min="0" step="0.001" value="0" /></div></div>
  <div class="field"><label class="checkbox-label"><input type="checkbox" data-field="compare" /> Compare a second appliance</label></div>
  <div class="field-grid appliance-b" hidden><div class="field"><label>Appliance B power (W)</label><input data-field="powerB" type="number" min="0" value="0" /></div><div class="field"><label>Hours per day</label><input data-field="hoursB" type="number" min="0" max="24" step="0.1" value="0" /></div><div class="field field-full energy-field" hidden><label>Daily energy (kWh)</label><input data-field="energyB" type="number" min="0" value="0" /></div><div class="field field-full"><label>Electricity price (USD/kWh)</label><input data-field="rateB" type="number" min="0" step="0.001" value="0" /></div></div>
  <div class="metric-grid"><div class="metric"><span>Daily electricity cost</span><strong data-elec-daily>$0.00</strong></div><div class="metric"><span>Monthly electricity cost</span><strong data-elec-monthly>$0.00</strong></div><div class="metric"><span>Annual electricity cost</span><strong data-elec-annual>$0.00</strong></div><div class="metric"><span>Annual energy use</span><strong data-elec-kwh>0 kWh</strong></div></div>
  <div class="metric-grid appliance-comparison" hidden><div class="metric"><span>Annual cost difference</span><strong data-elec-difference>—</strong></div><div class="metric"><span>Potential annual saving</span><strong data-elec-saving>—</strong></div><div class="metric"><span>Saving from one fewer hour/day</span><strong data-elec-hour-saving>—</strong></div></div>
</ToolShell>