---
import ToolShell from '../../components/ToolShell.astro';
---
<ToolShell title="Repair or Replace Calculator" category="Home costs" toolId="repair-replace" description="Compare the estimated annual cost of repairing an appliance or replacing it." intro="Compare repair and replacement using upfront costs, expected years of use, maintenance, and optional electricity costs." steps={["Enter the repair cost and expected years of use after repair.","Enter the new appliance price, delivery or installation, and expected years of use.","Add annual maintenance and optional annual electricity costs for both options.","Compare estimated annual costs."]} note="This is a simplified estimate. It does not account for the time value of money, repair failure risk, downtime, resale value, or future price changes. The lower estimate only appears cheaper based on the values entered.">
  <h2>Repair or replace an appliance?</h2><div class="field"><label for="repair-mode">Comparison detail</label><select id="repair-mode" data-field="repairMode"><option value="simple">Simple comparison</option><option value="detailed">Detailed annual cost comparison</option></select></div>
  <div class="field-grid"><div class="field"><label for="repair-cost">Repair quote ($)</label><input id="repair-cost" data-field="repairCost" type="number" min="0" value="0" /></div><div class="field"><label for="new-price">New appliance price ($)</label><input id="new-price" data-field="newPrice" type="number" min="0" value="0" /></div></div>
  <div class="detailed-fields" hidden><h3>Repair option</h3><div class="field-grid"><div class="field"><label>Expected years after repair</label><input data-field="repairYears" type="number" min="0" step="0.1" value="0" /></div><div class="field"><label>Annual maintenance ($)</label><input data-field="repairMaintenance" type="number" min="0" value="0" /></div><div class="field"><label>Annual electricity cost ($) <span class="optional">Optional</span></label><input data-field="repairEnergy" type="number" min="0" value="0" /></div></div><h3>Replacement option</h3><div class="field-grid"><div class="field"><label>Delivery / installation ($)</label><input data-field="installCost" type="number" min="0" value="0" /></div><div class="field"><label>Expected years of use</label><input data-field="replaceYears" type="number" min="0" step="0.1" value="0" /></div><div class="field"><label>Annual maintenance ($)</label><input data-field="replaceMaintenance" type="number" min="0" value="0" /></div><div class="field"><label>Annual electricity cost ($) <span class="optional">Optional</span></label><input data-field="replaceEnergy" type="number" min="0" value="0" /></div></div></div>
  <div class="metric-grid repair-results" hidden><div class="metric"><span>Repair annual cost</span><strong data-repair-annual>—</strong></div><div class="metric"><span>Replace annual cost</span><strong data-replace-annual>—</strong></div><div class="metric"><span>Annual difference</span><strong data-repair-difference>—</strong></div></div>
</ToolShell>