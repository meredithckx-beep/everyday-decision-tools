---
import ToolShell from '../../components/ToolShell.astro';
const units = [{value:'g',label:'grams (g)'},{value:'kg',label:'kilograms (kg)'},{value:'oz',label:'ounces (oz)'},{value:'lb',label:'pounds (lb)'},{value:'ml',label:'milliliters (mL)'},{value:'l',label:'liters (L)'},{value:'floz',label:'US fluid ounces (fl oz)'},{value:'each',label:'items (each)'}];
---
<ToolShell title="Unit Price Calculator" category="Shopping" toolId="unit-price" description="Compare compatible product unit prices across package sizes." intro="Compare two or more products by the amount you get for the price. Compatible units are converted automatically." steps={["Enter an optional product name, price, and package quantity for each product.","Choose the package unit. Compatible units such as grams and kilograms are converted automatically.","Add another product if needed, then compare unit prices and equivalent-basket costs."]} note="Compares costs only, not product quality.">
  <h2>Compare product prices</h2><p class="form-intro">Start with two products. Product names are optional.</p>
  <div id="products" class="compare-fields">
    {['A','B'].map((letter) => <fieldset class="product-field product-entry"><legend>Product {letter}</legend><label>Product name <span class="optional">Optional</span></label><input data-product-name placeholder="e.g. Brand or product" type="text" /><label>Price ($)</label><div class="input-wrap"><span>$</span><input data-price type="number" min="0" step="0.01" value="0" /></div><label>Package quantity</label><input data-quantity type="number" min="0" step="any" value="0" /><label>Unit</label><select data-unit>{units.map((unit) => <option value={unit.value}>{unit.label}</option>)}</select></fieldset>)}
  </div>
  <div class="calculator-actions"><button type="button" class="button button-secondary" id="add-product">+ Add another product</button></div>
  <div class="comparison-output" id="unit-comparison" aria-live="polite"><p>Enter package quantities greater than zero to compare.</p></div>
  <template id="product-template"><fieldset class="product-field product-entry"><legend>Product</legend><button type="button" class="remove-product" aria-label="Remove product">Remove</button><label>Product name <span class="optional">Optional</span></label><input data-product-name placeholder="e.g. Brand or product" type="text" /><label>Price ($)</label><div class="input-wrap"><span>$</span><input data-price type="number" min="0" step="0.01" value="0" /></div><label>Package quantity</label><input data-quantity type="number" min="0" step="any" value="0" /><label>Unit</label><select data-unit>{units.map((unit) => <option value={unit.value}>{unit.label}</option>)}</select></fieldset></template>
</ToolShell>