---
import ToolShell from '../../components/ToolShell.astro';
---
<ToolShell title="Cost Per Use Calculator" category="Shopping" toolId="cost-per-use" description="Calculate the cost of an item each time you use it. Compare purchases by expected lifetime value." intro="A higher upfront price can sometimes mean better value. Estimate how much an item costs each time you use it." steps={['Enter the item’s purchase price.','Estimate how many times you expect to use it.','Optionally add maintenance or other costs.','See the estimated cost for each use.']} note="This is an estimate based on the number of uses you enter. Actual value depends on product lifespan, upkeep, and how often you use it.">
  <h2>Calculate your cost per use</h2><p class="form-intro">Include the costs that matter to your decision.</p>
  <div class="field-grid"><div class="field"><label for="item-price">Purchase price ($)</label><div class="input-wrap"><span>$</span><input id="item-price" data-field="price" type="number" min="0" step="0.01" value="120" /></div></div><div class="field"><label for="uses">Expected number of uses</label><input id="uses" data-field="uses" type="number" min="1" step="1" value="200" /></div><div class="field field-full"><label for="extras">Extra costs over its lifetime ($) <span class="optional">Optional</span></label><div class="input-wrap"><span>$</span><input id="extras" data-field="extras" type="number" min="0" step="0.01" value="0" /></div></div></div>
</ToolShell>
