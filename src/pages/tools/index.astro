---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { tools } from '../../data.js';
---
<BaseLayout title="All Calculators" description="Explore free calculators for shopping, transportation, subscriptions, household energy, and appliance repair decisions.">
  <section class="page-hero"><div class="container narrow"><div class="eyebrow">The toolkit</div><h1>Everyday tools.<br /><em>Clearer decisions.</em></h1><p class="lead">Simple calculators for the costs and choices that come up in everyday life.</p></div></section>
  <section class="section"><div class="container"><div class="tool-grid">{tools.map((tool) => <ToolCard tool={tool} />)}</div></div></section>
</BaseLayout>