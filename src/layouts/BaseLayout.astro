
---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const maintenanceMode = true;

const {
  title,
  description,
  canonical,
  noindex = false,
} = Astro.props;

const pageTitle = maintenanceMode
  ? 'Temporarily Unavailable | Everyday Decision Tools'
  : title
    ? `${title} | Everyday Decision Tools`
    : 'Everyday Decision Tools | Make everyday choices with confidence';

const pageDescription = maintenanceMode
  ? 'Everyday Decision Tools is temporarily unavailable while we make improvements. Please check back soon.'
  : description ||
    'Free, practical calculators that help you compare everyday costs and make smarter purchase decisions.';

const canonicalUrl = canonical || new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL('/og-image.png', Astro.site).href;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f8f5" />

    <meta name="google-site-verification" content="sz6J8fE6ZBFmF44TGCBDnj9Tp4e_otnJnvDQ-FZfR14" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta
      name="robots"
      content={maintenanceMode ? 'noindex, nofollow' : noindex ? 'noindex, nofollow' : 'index, follow'}
    />

    <link rel="canonical" href={canonicalUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Everyday Decision Tools" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Everyday Decision Tools — free calculators for smarter everyday spending." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Everyday Decision Tools — free calculators for smarter everyday spending." />

    {maintenanceMode && (
      <style>
        {`
          .maintenance-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 32px 20px;
            background: #f7f8f5;
            text-align: center;
          }

          .maintenance-content {
            width: 100%;
            max-width: 560px;
          }

          .maintenance-icon {
            font-size: 48px;
            margin-bottom: 24px;
          }

          .maintenance-content h1 {
            margin: 0 0 18px;
            color: #24352c;
            font-size: clamp(30px, 6vw, 42px);
            line-height: 1.2;
          }

          .maintenance-content p {
            margin: 0 auto 14px;
            color: #66736b;
            font-size: 16px;
            line-height: 1.8;
          }

          .maintenance-label {
            display: inline-block;
            margin-bottom: 20px;
            padding: 7px 14px;
            border-radius: 20px;
            background: #e7eee8;
            color: #42634d;
            font-size: 13px;
            font-weight: 600;
          }
        `}
      </style>
    )}
  </head>

  <body>
    {maintenanceMode ? (
      <main class="maintenance-page">
        <div class="maintenance-content">
          <div class="maintenance-icon">🛠️</div>
          <span class="maintenance-label">Scheduled Maintenance</span>
          <h1>We'll Be Back Soon</h1>
          <p>
            Everyday Decision Tools is temporarily unavailable while we're
            working on improvements.
          </p>
          <p>
            We're making things better for you. Please check back soon.
          </p>
          <p>Thank you for your patience!</p>
        </div>
      </main>
    ) : (
      <>
        <a class="skip-link" href="#main">Skip to content</a>
        <Header />
        <main id="main"><slot /></main>
        <Footer />
      </>
    )}
  </body>
</html>
